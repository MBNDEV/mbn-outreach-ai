DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
APP_ENCRYPTION_KEY="<64-hex-chars — node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\">"

# Optional: enable Google / Microsoft mailbox OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Optional: AI features (sequence generation, reply classification)
ANTHROPIC_API_KEY=""
# Optional: paid email-verification provider in the waterfall
HUNTER_API_KEY=""
# Set to 1 to disable the background send/sync loops
DISABLE_SEND_ENGINE=""

# Optional: Stripe billing (plans + credit packs). Without these the billing UI
# explains what to set and plans stay assignable in the database.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_SCALE=""
STRIPE_PRICE_AGENCY=""
STRIPE_PRICE_CREDITS=""

# Optional: lead-database partner for /leads/search
APOLLO_API_KEY=""

# Optional: Slack incoming webhook for reply + pipeline notifications is set
# per workspace in Settings, not here.

# Optional: sell domains and mailboxes through the marketplace. Without a
# registrar the app still runs the bring-your-own path (DNS plan, verification,
# mailbox connection, warmup) — it just cannot buy the domain for you.
PORKBUN_API_KEY=""
PORKBUN_SECRET_KEY=""
MAILBOX_HOST_API_URL=""
MAILBOX_HOST_API_KEY=""
STRIPE_PRICE_DOMAIN=""
STRIPE_PRICE_MAILBOX=""
MARKETPLACE_DOMAIN_PRICE_CENTS="1800"
MARKETPLACE_MAILBOX_PRICE_CENTS="400"

# Optional: calls and SMS. Consent, quiet hours, opt-out and call logging work
# without these; sending and click-to-call need them. Point the number's
# messaging webhook at /api/twilio/sms and its status callback at
# /api/twilio/status.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Override only for testing against a local stand-in.
TWILIO_API_BASE=""
scope per-prospect offer selection